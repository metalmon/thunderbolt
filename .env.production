# Fork production build flags — tracked so every checkout/worktree bakes them in.
# Non-secret.
#
# VITE_THUNDERBOLT_CLOUD_URL is one name for every deployment: the customer points
# it at their own backend with an internal DNS zone on exactly this FQDN (or a
# hosts entry), so one build serves all of them instead of one build per customer.
# There is deliberately NO public A record — in a closed perimeter external DNS is
# unreachable anyway, and the absence makes a misconfigured client fail loudly
# instead of silently reaching someone else's host with its tokens.
# `.local` would have been wrong here: RFC 6762 reserves it for mDNS, so the query
# never reaches the corporate resolver, and no CA will issue for it.
#
# Deployment side: dev-local/docker/README-pilot-tls.md.
# NOTE: the value is persisted in localStorage, so an upgrade over an existing
# install keeps whatever address it first saw — see the same runbook.
VITE_THUNDERBOLT_CLOUD_URL="https://backend.volt.oktaplus.ru/v1"
# Keycloak, not the consumer flow: every deployment of this fork authenticates
# through the customer's own IdP. Without VITE_AUTH_MODE the build falls back to
# consumer mode and asks the backend for /sign-in/anonymous, which an AUTH_MODE=oidc
# backend does not mount — the installed client then dies on a 404 before showing
# anything. Found by installing the pilot build against the pilot stack.
VITE_AUTH_MODE=sso
VITE_AUTH_ENABLE_ANONYMOUS=false
VITE_BYPASS_WAITLIST="true"

# No self-update inside a closed perimeter: the client cannot reach the update
# channel, and the failed check surfaced as an error the operator could do nothing
# about. The flag is opt-out by design (`src/fork/updater/updater-enabled.ts`:
# unset keeps the updater working, so an ordinary build is unaffected), which means
# the decision only holds where the value is actually set. It is set as a GitHub repo
# variable too — that one wins in CI — but keeping it HERE is what makes "always off"
# a property of the checkout rather than of one CI configuration: a local
# `tauri build`, a fresh clone, or a worktree all bake it in as well.
VITE_UPDATER_ENABLED=false
