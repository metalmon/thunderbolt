# Copy to `openrouter.env` (git-ignored) and fill in real key(s) to enable the
# free OpenRouter demo models. Without this file the stack still boots; the
# free models just return 503 until a key is provided.
# Comma-separated keys — ideally from DIFFERENT OpenRouter accounts so the
# per-account free-tier rate limit actually multiplies.
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Per-user requests/minute cap on the free models (in-memory throttle).
OPENROUTER_FREE_RPM=10

# Self-hosted search + scrape (Phase 3). Empty ⇒ backend falls back to Exa.
# SEARXNG_URL / FIRECRAWL_URL point at the compose services; FIRECRAWL_TOKEN is
# any UUID (Firecrawl Simple only validates the token format).
SEARXNG_URL=http://searxng:8080
FIRECRAWL_URL=http://firecrawl-api:3002
FIRECRAWL_TOKEN=00000000-0000-4000-8000-000000000000
