# Copy to `secrets.env` (git-ignored) and fill in real key(s) to enable the
# free OpenRouter demo models. Without this file the stack still boots; the
# free models just return 503 until a key is provided.
# Comma-separated keys — ideally from DIFFERENT OpenRouter accounts so the
# per-account free-tier rate limit actually multiplies.
OPENROUTER_API_KEYS=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Per-user requests/minute cap on the free models (in-memory throttle).
OPENROUTER_FREE_RPM=10

# Self-hosted search + scrape (Phase 3). Empty ⇒ backend falls back to Exa.
# SEARXNG_URL / FIRECRAWL_URL point at the compose services; FIRECRAWL_TOKEN is
# any UUID (Firecrawl Simple only validates the token format).
SEARXNG_URL=http://searxng:8080
FIRECRAWL_URL=http://firecrawl-api:3002
FIRECRAWL_TOKEN=00000000-0000-4000-8000-000000000000

# Outbound egress proxy for cloud APIs (OpenRouter etc.) when the host reaches
# the internet only through a per-process proxifier that does NOT hook this
# container (e.g. Proxifier + fake-DNS 127.x). Point the container's fetch at
# the upstream HTTP-CONNECT proxy directly; the proxy resolves the domain
# remotely. NO_PROXY (in docker-compose.yml) keeps internal services off it.
# Leave unset if the container has normal internet egress. Bun fetch honours it.
# HTTPS_PROXY=http://USER:PASS@proxy-host:port
# HTTP_PROXY=http://USER:PASS@proxy-host:port

# ---------------------------------------------------------------------------
# voltd agent auto-discovery (fork). Unset VOLTD_URL ⇒ the whole feature is
# inert: no agent provider registered, no relay route mounted.
#
# The gateway must be wss:// unless the host is loopback — otherwise the minted
# access token would travel in clear text and the feature disables itself.
#
# Keys: generate an ES256 pair into powersync-service/voltd-keys/ (git-ignored),
# which the backend container mounts at /etc/volt/voltd-keys:
#   openssl ecparam -name prime256v1 -genkey -noout -out ec.key
#   openssl pkcs8 -topk8 -nocrypt -in ec.key -out voltd-keys/signing.key.pem
#   openssl ec -in ec.key -pubout -out voltd-keys/signing.pub.pem && rm ec.key
# Paths, not values, on purpose: a PEM is multi-line so env_file cannot carry
# one, and a private key in an env var leaks into `docker inspect`.
# ---------------------------------------------------------------------------
# VOLTD_URL=wss://127.0.0.1:8453/acp
#
# Issuer we stamp into `iss` and serve discovery at. Must match the gateway's
# `[oidc.<alias>].issuer` BYTE FOR BYTE. Note the `/v1`: the app is mounted under
# that prefix, so discovery lives at <issuer>/.well-known/openid-configuration.
# Defaults to BETTER_AUTH_URL + /v1, which is usually NOT what the gateway sees —
# set it explicitly whenever the gateway reaches us by another address (a sidecar
# forward, for instance).
# VOLTD_ISSUER=http://127.0.0.1:9898/v1
# Dotted path to the group claim the IdP emits. Keycloak's Group Membership
# mapper uses `groups` (the default); realm roles would be `realm_access.roles`.
# VOLTD_GROUPS_CLAIM=groups
#
# The realm defines the groups the gateway maps to permission profiles, and the
# mapper that emits them, but assigns them to NO ONE.
#
# Names come from the gateway side, so they must match its `profile_map` exactly:
#   pilot  (_local/pilot-kit/volt/conf/config.toml)
#     volt-admins -> operator   volt-avk -> avk   volt-kb -> kb
#   dev stand (zc-conf-8289)
#     volt-admins -> operator   volt-crm -> crm
# All four ship so either stand works without editing the realm. That is deliberate: the `demo` user
# ships with the password `demo` in git, and pre-wiring a known credential into a
# group the gateway maps to a permission profile is a standing privilege grant
# that would travel with this file. To test the live path, add the group to a user
# yourself — Keycloak admin → Groups → volt-crm → Members → Add, or
#   docker compose exec keycloak /opt/keycloak/bin/kcadm.sh ...
