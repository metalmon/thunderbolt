{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt",
  "version": "0.1.152",
  "identifier": "ru.metalmon.volt",
  "mainBinaryName": "Volt",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Volt",
        "width": 1400,
        "height": 1000,
        "minHeight": 600,
        "minWidth": 500,
        "visible": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' tauri: asset:",
        "frame-src": "'self' https: sandbox: http://sandbox.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: blob: ws://127.0.0.1:* http://127.0.0.1:* ws://localhost:* http://localhost:*",
        "img-src": "'self' asset: data: blob: https: https://api.thunderbolt.io https://cdn.agentclientprotocol.com",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Окта Плюс",
    "shortDescription": "Volt: клиент ИИ-ассистента",
    "longDescription": "Volt, клиент ИИ-ассистента. Окта Плюс, info@oktaplus.ru",
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "template": "installer.nsi",
        "installerHooks": "installer-hooks.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "volt.desktop"
      },
      "rpm": {
        "desktopTemplate": "volt.desktop"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": [
        "MetalPerformanceShaders.framework",
        "MetalKit.framework",
        "Metal.framework"
      ],
      "developmentTeam": "BUMSKVQ3D9",
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "versionCode": 1018
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "app.thunderbolt.io",
          "pathPrefix": [
            "/oauth/callback",
            "/auth/verify"
          ],
          "appLink": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/metalmon/thunderbolt/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMjA3NjczRTM5MEY0MjgKUldRbzlKRGpjM1lnL1JCTHlMcnNybUZSSWJWN25YcGpaR0FuK3FGTm1Yd3RUNTJpZFVRUVE0bDgK"
    }
  }
}
