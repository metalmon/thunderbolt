{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Volt",
  "version": "0.1.129",
  "identifier": "ru.metalmon.volt",
  "mainBinaryName": "Volt",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Volt",
        "width": 1400,
        "height": 1000,
        "minHeight": 600,
        "minWidth": 500,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self' tauri: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss: blob: ws://localhost:8000 http://localhost:8000 ws://localhost:8080 http://localhost:8080 ws://127.0.0.1:8839 ws://127.0.0.1:8840 http://localhost:11434 https://opencode.ai",
        "img-src": "'self' asset: data: blob: https://api.thunderbolt.io",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "frameworks": [
        "MetalPerformanceShaders.framework",
        "MetalKit.framework",
        "Metal.framework"
      ],
      "developmentTeam": "BUMSKVQ3D9",
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "versionCode": 1018
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "app.thunderbolt.io",
          "pathPrefix": [
            "/oauth/callback",
            "/auth/verify"
          ],
          "appLink": true
        }
      ]
    },
    "updater": {
      "endpoints": [
        "https://cdn.crabnebula.app/update/metalmon/thunderbolt/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEMjA3NjczRTM5MEY0MjgKUldRbzlKRGpjM1lnL1JCTHlMcnNybUZSSWJWN25YcGpaR0FuK3FGTm1Yd3RUNTJpZFVRUVE0bDgK"
    }
  }
}
