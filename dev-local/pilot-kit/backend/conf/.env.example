# Volt pilot kit — environment template.
#
# Copy this file to `.env` NEXT TO docker-compose.yml (the kit root, not
# conf/) — that is the one place `docker compose` auto-loads it from, and it
# is also the file `backend`'s env_file points at.
#   cp conf/.env.example .env
# Or just run scripts/gen-secrets.sh|ps1 <public-hostname-or-ip>, which does
# the copy AND fills in every generated value below.
#
# NO REAL SECRETS ARE COMMITTED HERE. Every value below is a placeholder or a
# safe demo default — regenerate before any real pilot use.

# ============================================================
# Public endpoints (used for docker-compose.yml ${VAR} substitution)
# ============================================================

# Name of the docker compose project. Pinned rather than derived from the directory
# name, which is what compose does by default: renaming the folder renames the project,
# which orphans the running containers and the named volume holding Keycloak's accounts,
# and brings up a second, empty stack beside the first. That is exactly what happened
# and brings up a second, empty stack beside the first - as a rename here once did.
COMPOSE_PROJECT_NAME=volt

# REQUIRED. Origin the SPA/API/PowerSync are served from (what desktop
# clients and browsers hit). Plain http://<ip-or-host>:3000 for a no-TLS
# pilot, or https://<name> when running with `--profile tls`.
PUBLIC_URL=http://localhost:3000

# REQUIRED (AUTH_MODE is locked to oidc). Keycloak's OWN browser-facing
# origin — must equal Keycloak's KC_HOSTNAME and the realm issuer. Local/no-TLS
# default is fine; with the tls profile use https://<name>:8444 (8443 is voltd's public /acp port on the same host).
KEYCLOAK_PUBLIC_URL=http://localhost:8180

# REQUIRED only when running `docker compose --profile tls`. Must equal the
# SAN baked into conf/certs/fullchain.pem and the host part of PUBLIC_URL /
# KEYCLOAK_PUBLIC_URL. See README-pilot-tls.md.
VOLT_TLS_SERVER_NAME=

# OPTIONAL. Host port for `web` when NOT using the tls profile (plain HTTP).
WEB_PORT=3000

# OPTIONAL. Bind address for the PLAIN-HTTP ports — `web` and Keycloak's 8180.
# Loopback by default, on purpose: with the tls profile those two are only the
# terminator's upstreams, and publishing them on the LAN would serve the SPA and
# the login form — with the passwords typed into it — in clear text beside the
# very TLS listener meant to prevent that. The backend's own 8000 is loopback
# unconditionally; nothing outside the host ever needs it.
# gen-secrets sets this to 0.0.0.0 only when generating a no-TLS .env.
VOLT_BIND_ADDR=127.0.0.1

# OPTIONAL. Host ports for the `tls` terminator (profile `tls` only).
VOLT_TLS_HTTP_PORT=80
VOLT_TLS_HTTPS_PORT=443
VOLT_TLS_KEYCLOAK_HTTPS_PORT=8444

# OPTIONAL. Directory holding fullchain.pem + privkey.pem for the tls
# profile. Default points at the kit's own conf/certs/ — put the files there.
VOLT_TLS_CERT_DIR=./conf/certs

# OPTIONAL. Path INSIDE the backend container (mounted from
# VOLT_TLS_CERT_DIR at /etc/volt/certs) to a private CA the backend's
# outbound proxy must trust, e.g. /etc/volt/certs/ca.crt. Needed only if a
# model/MCP endpoint on the pilot's LAN is signed by that same private CA.
VOLT_BACKEND_EXTRA_CA=

# ============================================================
# Postgres
# ============================================================

# REQUIRED. Generate: openssl rand -base64 24
# Must stay in sync automatically — the compose file reads this same value
# for both the postgres service and the backend's DATABASE_URL.
POSTGRES_PASSWORD=postgres

# Password of the Postgres role PowerSync replicates as. Created on the FIRST start of
# postgres and never changed afterwards, so rotating it here on a running stand breaks
# replication until the role is altered by hand.
POWERSYNC_DB_PASSWORD=powersync-dev-password-change-in-production

# ============================================================
# Backend secrets
# ============================================================

# REQUIRED. Signs session cookies/bearer tokens. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# REQUIRED, >=32 chars. Generate: openssl rand -base64 32
# gen-secrets.sh/.ps1 ALSO rewrites the matching HS256 key in
# conf/powersync/config.yaml (client_auth.jwks.keys[0].k) when it generates
# this — if you change this by hand later, update that key too or sync breaks.
POWERSYNC_JWT_SECRET=powersync-dev-secret-change-in-production

# OPTIONAL. Must match conf/powersync/config.yaml jwks kid.
POWERSYNC_JWT_KID=powersync-dev

# base64url of POWERSYNC_JWT_SECRET — this is the form a JWK carries. gen-secrets.sh
# derives it; by hand, `openssl base64 -A | tr '+/' '-_' | tr -d '='` over the secret.
# Wrong encoding here means the PowerSync service rejects every token the backend mints.
POWERSYNC_JWT_K=cG93ZXJzeW5jLWRldi1zZWNyZXQtY2hhbmdlLWluLXByb2R1Y3Rpb24

# ============================================================
# AI provider — at least ONE of these is REQUIRED for the backend to serve
# chat requests. Leave the rest empty.
# ============================================================
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=
VOLT_INFERENCE_API_KEY=

# ============================================================
# Keycloak OIDC — AUTH_MODE is locked to oidc for this kit.
# ============================================================

# REQUIRED. Must match the `clientId` in conf/keycloak/realm.json.
OIDC_CLIENT_ID=volt-app

# REQUIRED. Must match the `secret` field of that same client in
# conf/keycloak/realm.json. If you change this, edit realm.json's client
# secret to match (openssl rand -hex 16) — they are not auto-synced.
OIDC_CLIENT_SECRET=volt-dev-secret

# REQUIRED. Keycloak bootstrap admin console password (used once to log into
# /admin at KEYCLOAK_PUBLIC_URL). Generate: openssl rand -base64 18
KEYCLOAK_ADMIN_PASSWORD=admin

# ============================================================
# Optional externals
# ============================================================

# OPTIONAL. Web-search fallback. This kit ships WITHOUT Firecrawl/SearXNG, so
# web_search/fetch_content tools stay unavailable unless this is set.
EXA_API_KEY=
