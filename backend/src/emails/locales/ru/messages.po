#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "If this wasn’t you, revoke that device from Settings → Devices and change your recovery phrase immediately."
msgstr "Если это были не вы, отзовите это устройство в «Настройки → Устройства» и немедленно смените фразу восстановления."

#. js-lingui-explicit-id
#: src/emails/security-code.tsx
#: src/lib/security-notifications.tsx
msgid "Confirm your recovery phrase change"
msgstr "Подтвердите смену фразы восстановления"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Your recovery phrase was changed"
msgstr "Фраза восстановления изменена"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Your Thunderbolt recovery phrase was changed from device “{deviceName}”. Your previous phrase no longer works."
msgstr "Фраза восстановления Volt изменена с устройства «{deviceName}». Предыдущая фраза больше не работает."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "A new device was added to your account"
msgstr "В аккаунт добавлено новое устройство"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Device “{deviceName}” was approved from device “{approverName}” and now has access to your encrypted data."
msgstr "Устройство «{deviceName}» подтверждено с устройства «{approverName}» и теперь имеет доступ к вашим зашифрованным данным."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "If this wasn’t you, revoke it from Settings → Devices."
msgstr "Если это были не вы, отзовите его в «Настройки → Устройства»."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Your recovery phrase was used"
msgstr "Использована фраза восстановления"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Device “{deviceName}” was connected to your account using your recovery phrase."
msgstr "Устройство «{deviceName}» подключено к аккаунту с помощью фразы восстановления."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "If this wasn’t you, your recovery phrase is compromised — revoke that device from Settings → Devices and change your phrase immediately."
msgstr "Если это были не вы, фраза восстановления скомпрометирована — отзовите это устройство в «Настройки → Устройства» и немедленно смените фразу."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "A bridge device was connected to your account"
msgstr "К аккаунту подключено устройство-мост"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Bridge device “{deviceName}” was connected to your account and now has access to your encrypted data."
msgstr "Устройство-мост «{deviceName}» подключено к аккаунту и теперь имеет доступ к вашим зашифрованным данным."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Your account encryption was upgraded"
msgstr "Шифрование аккаунта обновлено"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "End-to-end encryption was set up"
msgstr "Сквозное шифрование настроено"

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "Your account was upgraded to the new encryption scheme from device “{deviceName}”, and a new recovery phrase was created."
msgstr "Аккаунт переведён на новую схему шифрования с устройства «{deviceName}», создана новая фраза восстановления."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "End-to-end encryption was set up for your account from device “{deviceName}”, and a recovery phrase was created."
msgstr "Для аккаунта настроено сквозное шифрование с устройства «{deviceName}», создана фраза восстановления."

#. js-lingui-explicit-id
#: src/lib/security-notifications.tsx
msgid "If this wasn’t you, secure your account now: revoke unknown devices from Settings → Devices."
msgstr "Если это были не вы, защитите аккаунт сейчас: отзовите неизвестные устройства в «Настройки → Устройства»."

#. js-lingui-explicit-id
#: src/emails/email-layout.tsx
msgid "Questions?"
msgstr "Вопросы?"

#. js-lingui-explicit-id
#: src/emails/email-layout.tsx
msgid "You can reply to this email"
msgstr "Вы можете ответить на это письмо"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Your Thunderbolt verification code"
msgstr "Ваш код подтверждения Volt"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Sign in to Thunderbolt"
msgstr "Вход в Volt"

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Use the code below to sign in, or click the button."
msgstr "Используйте код ниже для входа или нажмите кнопку."

#. js-lingui-explicit-id
#: src/emails/magic-link.tsx
msgid "Sign In"
msgstr "Войти"

#. js-lingui-explicit-id
#: src/emails/security-code.tsx
msgid "A recovery phrase change was requested from device “{deviceName}”. Enter this code in the app to continue."
msgstr "С устройства «{deviceName}» запрошена смена фразы восстановления. Введите этот код в приложении, чтобы продолжить."

#. js-lingui-explicit-id
#: src/emails/security-code.tsx
msgid "If this wasn’t you, don’t enter the code — revoke that device from Settings → Devices."
msgstr "Если это были не вы, не вводите код — отзовите это устройство в «Настройки → Устройства»."

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
#: src/emails/waitlist-not-ready.tsx
msgid "You're on the Thunderbolt waitlist!"
msgstr "Вы в списке ожидания Volt!"

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
msgid "Thanks for signing up!"
msgstr "Спасибо за регистрацию!"

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
msgid "You've been added to the Thunderbolt waitlist. We're working hard to get you access as soon as possible. We'll send you another email when it's your turn to join."
msgstr "Вы добавлены в список ожидания Volt. Мы усердно работаем, чтобы открыть вам доступ как можно скорее. Мы пришлём ещё одно письмо, когда придёт ваша очередь."

#. js-lingui-explicit-id
#: src/emails/waitlist-joined.tsx
#: src/emails/waitlist-not-ready.tsx
#: src/emails/waitlist-reminder.tsx
msgid "The Thunderbolt Team"
msgstr "Команда Volt"

#. js-lingui-explicit-id
#: src/emails/waitlist-not-ready.tsx
msgid "Not quite ready yet!"
msgstr "Пока не совсем готово!"

#. js-lingui-explicit-id
#: src/emails/waitlist-not-ready.tsx
msgid "We noticed you tried to sign in to Thunderbolt. You're on our waitlist, but we're not quite ready for you yet. Don't worry — we're working hard to get you access as soon as possible. We'll send you an email when it's your turn to join."
msgstr "Мы заметили, что вы пытались войти в Volt. Вы в списке ожидания, но мы пока не готовы вас принять. Не волнуйтесь — мы усердно работаем, чтобы открыть доступ как можно скорее. Мы пришлём письмо, когда придёт ваша очередь."

#. js-lingui-explicit-id
#: src/emails/waitlist-reminder.tsx
msgid "You're already on the waitlist!"
msgstr "Вы уже в списке ожидания!"

#. js-lingui-explicit-id
#: src/emails/waitlist-reminder.tsx
msgid "Good news — you're already on the Thunderbolt waitlist. No need to sign up again! We're working hard to get you access as soon as possible. We'll send you an email when it's your turn to join."
msgstr "Хорошая новость — вы уже в списке ожидания Volt. Регистрироваться заново не нужно! Мы усердно работаем, чтобы открыть доступ как можно скорее. Мы пришлём письмо, когда придёт ваша очередь."
